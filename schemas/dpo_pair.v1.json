{
  "$defs": {
    "Competency": {
      "description": "The six competencies — contract §1 Six Competencies @ V0.1.0.",
      "enum": [
        "emotional_awareness",
        "cognitive_discipline",
        "personal_accountability",
        "behavioral_control",
        "healthy_boundaries",
        "long_term_resilience"
      ],
      "type": "string"
    },
    "CriticalFailure": {
      "description": "Critical failure — contract §3 Critical Failures @ V0.1.0. Hard rejects.",
      "oneOf": [
        {
          "const": "revenge_or_harassment",
          "description": "§3.1 Revenge or Harassment",
          "type": "string"
        },
        {
          "const": "shame_based_discipline",
          "description": "§3.2 Shame-Based Discipline",
          "type": "string"
        },
        {
          "const": "enabling_substance_use",
          "description": "§3.3 Enabling Substance Use in Recovery",
          "type": "string"
        },
        {
          "const": "fostering_ai_dependence",
          "description": "§3.4 Fostering AI Dependence",
          "type": "string"
        }
      ]
    },
    "Difficulty": {
      "description": "Scenario difficulty — taxonomy \"Difficulty quotas\" (#12).",
      "enum": [
        "everyday",
        "moderate",
        "acute"
      ],
      "type": "string"
    },
    "FailureMode": {
      "description": "Failure mode tagged on the rejected side of a DPO pair (D3, mapped from\n#18's scope).",
      "enum": [
        "shaming",
        "enabling",
        "revenge_encouraging",
        "boundary_violating",
        "validation_seeking_reinforcement",
        "dependence_fostering"
      ],
      "type": "string"
    },
    "Family": {
      "description": "Scenario family — taxonomy \"Scenario families\" (#12).",
      "enum": [
        "breakups",
        "anger",
        "discipline_motivation",
        "recovery",
        "jealousy",
        "boundaries",
        "failure_setbacks"
      ],
      "type": "string"
    },
    "GeneratorKind": {
      "description": "Who or what produced the record — `Provenance::generator_kind` (D6).",
      "enum": [
        "procedural",
        "teacher",
        "human"
      ],
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a record came from (D6).",
      "properties": {
        "generated_at": {
          "description": "ISO date (`YYYY-MM-DD`).",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "generator_id": {
          "description": "Model name or template-set id.",
          "type": "string"
        },
        "generator_kind": {
          "$ref": "#/$defs/GeneratorKind"
        },
        "prompt_version": {
          "type": "string"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "generator_kind",
        "generator_id",
        "prompt_version",
        "generated_at"
      ],
      "type": "object"
    },
    "VerificationResult": {
      "additionalProperties": false,
      "description": "Shape of a verification result (D6). This schema carries the shape only —\nscoring logic is issue #17.",
      "properties": {
        "critical_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/CriticalFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "privacy_pass": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "rubric_score": {
          "format": "uint8",
          "maximum": 5,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/VerificationStatus"
        },
        "verified_at": {
          "description": "ISO date (`YYYY-MM-DD`).",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": [
            "string",
            "null"
          ]
        },
        "verified_by": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "VerificationStatus": {
      "description": "Verification outcome — `VerificationResult::status` (D6).",
      "enum": [
        "pending",
        "admitted",
        "rejected"
      ],
      "type": "string"
    }
  },
  "$id": "https://github.com/rmems/euthymia/blob/main/schemas/dpo_pair.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One DPO preference pair (D5).",
  "properties": {
    "chosen": {
      "description": "The contract-compliant response. Never a negative fixture (D5).",
      "type": "string"
    },
    "contract_version": {
      "const": "V0.1.0"
    },
    "difficulty": {
      "$ref": "#/$defs/Difficulty"
    },
    "family": {
      "$ref": "#/$defs/Family"
    },
    "is_negative_fixture": {
      "description": "Labels a pair built around a §3-violating rejected side (D5).",
      "type": "boolean"
    },
    "pair_id": {
      "pattern": "^eu-dpo-[0-9]{3}$",
      "type": "string"
    },
    "primary_competency": {
      "$ref": "#/$defs/Competency"
    },
    "prompt": {
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "rejected": {
      "description": "The rejected response, tagged with `rejected_failure_mode`.",
      "type": "string"
    },
    "rejected_failure_mode": {
      "$ref": "#/$defs/FailureMode"
    },
    "scenario_id": {
      "description": "The SFT scenario this pair derives from.",
      "pattern": "^eu-(brk|ang|dis|rec|jel|bnd|fal)-[0-9]{3}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationResult"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null until verification (#17) runs."
    }
  },
  "required": [
    "schema_version",
    "pair_id",
    "scenario_id",
    "family",
    "primary_competency",
    "difficulty",
    "prompt",
    "chosen",
    "rejected",
    "rejected_failure_mode",
    "provenance",
    "contract_version",
    "is_negative_fixture"
  ],
  "title": "DpoPairRecord",
  "type": "object"
}
